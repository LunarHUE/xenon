{
  "name": "@xenon/suite",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:scripts && vitest run --project jsdom",
    "test:scripts": "bun test scripts/*.test.ts",
    "test:browser": "vitest run --project browser",
    "spec:check": "bun test scripts/spec-coverage.test.ts && bun scripts/check-spec.ts",
    "test:spec": "bun test scripts/spec-coverage.test.ts",
    "spec:report": "bun scripts/check-spec.ts --output packages/suite/.vitest/spec-coverage",
    "spec:tick": "vitest run --project jsdom --reporter=json --outputFile=.vitest/results.json; bun scripts/tick-spec.ts .vitest/results.json",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:browser:all": "xenon_BROWSERS=chromium,firefox,webkit vitest run --project browser",
    "campaign:report": "bun scripts/campaign-report.ts",
    "campaign:check": "bun scripts/campaign-report.ts --check",
    "campaign:test": "bun test scripts/campaign-report.test.ts"
  },
  "dependencies": {
    "@xenon-ui/core": "workspace:*",
    "@xenon-ui/dom": "workspace:*",
    "@xenon-ui/solid": "workspace:*",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@typescript/compiler-api": "npm:typescript@6.0.3",
    "@xenon/eslint-config": "workspace:*",
    "@xenon/typescript-config": "workspace:*",
    "@solidjs/vite-plugin": "^3.0.0-next.49",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/browser-playwright": "^5.0.0",
    "axe-core": "^4.13.0",
    "eslint": "catalog:",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  }
}
