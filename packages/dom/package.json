{
  "name": "@xenon/dom",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@xenon/eslint-config": "workspace:*",
    "@xenon/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^30.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "tabbable": "^6.5.0",
    "@floating-ui/dom": "^1.8.0"
  }
}
