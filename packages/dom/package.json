{
  "name": "@xenon-ui/dom",
  "version": "0.1.0",
  "description": "Framework-free DOM interactions for Xenon components: focus scopes, layers, positioning, modals and toasts.",
  "license": "MIT",
  "keywords": [
    "headless",
    "accessibility",
    "focus",
    "positioning",
    "dom"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/xenon.git",
    "directory": "packages/dom"
  },
  "homepage": "https://github.com/LunarHUE/xenon#readme",
  "bugs": "https://github.com/LunarHUE/xenon/issues",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@xenon/eslint-config": "workspace:*",
    "@xenon/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^30.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "tabbable": "^6.5.0",
    "@floating-ui/dom": "^1.8.0"
  }
}
