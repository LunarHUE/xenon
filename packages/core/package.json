{
  "name": "@tenon/core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "gen": "bun scripts/gen-attrs.ts",
    "lint": "eslint . && bun scripts/gen-attrs.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tenon/eslint-config": "workspace:*",
    "@tenon/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "aria-attributes": "^2.0.1",
    "eslint": "catalog:",
    "html-element-attributes": "^3.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
