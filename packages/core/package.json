{
  "name": "@xenon/core",
  "version": "0.1.0",
  "description": "Framework-free behavior for Xenon components: state, keyboard handling and ARIA attribute maps in plain TypeScript.",
  "license": "MIT",
  "keywords": [
    "headless",
    "accessibility",
    "aria",
    "components",
    "state-machine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarHUE/xenon.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/LunarHUE/xenon#readme",
  "bugs": "https://github.com/LunarHUE/xenon/issues",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "gen": "bun scripts/gen-attrs.ts",
    "lint": "eslint . && bun scripts/gen-attrs.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@xenon/eslint-config": "workspace:*",
    "@xenon/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "aria-attributes": "^2.0.1",
    "eslint": "catalog:",
    "html-element-attributes": "^3.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
