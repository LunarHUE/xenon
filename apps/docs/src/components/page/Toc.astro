---
/**
 * "On this page": Top, then one link per `<Section>` (and per `<Props>` group
 * and prop on API pages). The list is built at compile time (see
 * lib/section-toc.ts), so it is plain links without JavaScript. The script
 * marks every row whose part of the page is on screen with `data-in-view`,
 * which turns that row's rule into the pink bar. Marked neighbours touch, so
 * together they read as one bar the height of what you can see.
 *
 * There's no `aria-current`: it names one current item, and several rows can
 * be marked at once. The bar only mirrors the viewport, which a screen reader
 * user doesn't navigate by, so it stays visual.
 */
import type { PageSection } from '../../lib/sections'

interface Props {
  sections: PageSection[]
}

const { sections } = Astro.props
const links = [{ id: 'top', title: 'Top' }, ...sections]
---

<nav aria-label="On this page" data-docs-toc class="sticky top-6 flex flex-col">
  <p class="mb-2 border-t-2 border-b border-t-foreground border-b-muted-foreground py-[10px] font-mono text-[11px] leading-[19px] font-medium tracking-[0.06em] uppercase [border-bottom-style:dashed]">
    On this page
  </p>
  <ul class="flex flex-col">
    {links.map((link) => (
      <li class="flex">
        <a
          href={`#${link.id}`}
          class:list={[
            'relative flex-1 border-s border-foreground py-[7px] ps-3 text-[13px] leading-5 [overflow-wrap:anywhere] text-muted-foreground hover:underline hover:underline-offset-4',
            // The bar sits over the 1px rule and grows 2px into the padding, so the text never moves.
            'before:absolute before:inset-y-0 before:-start-px before:w-[3px] before:bg-sidebar-primary before:opacity-0 before:transition-opacity before:duration-150 motion-reduce:before:transition-none data-in-view:before:opacity-100',
            'focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring',
          ]}
        >
          {link.title}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // A row is in view while any of its stretch of the page is on screen. A
  // stretch starts at the top of the heading's section (or prop row) and ends
  // where that element ends or the next entry begins, whichever comes first,
  // so a Props group's own stretch is its heading and lead, not its props.
  // Top runs from the start of the document to the first entry.
  const toc = document.querySelector<HTMLElement>('[data-docs-toc]')
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
    const blocks = links.map((link, index) => {
      if (index === 0) return null
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
      return heading?.closest<HTMLElement>('section, article') ?? heading
    })
    let frame = 0

    const update = () => {
      frame = 0
      const boxes = blocks.map((block) => block?.getBoundingClientRect())
      links.forEach((link, index) => {
        const box = index === 0 ? { top: -scrollY, bottom: Infinity } : boxes[index]
        const next = boxes.slice(index + 1).find(Boolean)
        const bottom = Math.min(box?.bottom ?? -Infinity, next?.top ?? Infinity)
        link.toggleAttribute('data-in-view', !!box && box.top < innerHeight && bottom > 0)
      })
    }
    const schedule = () => {
      frame ||= requestAnimationFrame(update)
    }

    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', schedule)
    // Opening a code panel or switching example styles moves everything below it.
    new ResizeObserver(schedule).observe(document.body)
    update()
  }
</script>
