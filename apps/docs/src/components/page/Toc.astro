---
/**
 * "On this page": Top, then one link per `<Section>` (and per `<Props>` group
 * and prop on API pages). The list is built at compile time (see
 * lib/section-toc.ts), so it is plain links without JavaScript. The script
 * marks every row whose heading is on screen with `data-in-view`, which turns
 * that row's rule into the pink bar. Marked neighbours touch, so together they
 * read as one bar.
 *
 * There's no `aria-current`: it names one current item, and several rows can
 * be marked at once. The bar only mirrors the viewport, which a screen reader
 * user doesn't navigate by, so it stays visual.
 *
 * The top rule sits on the breadcrumb row's bottom rule (3.5rem tall, see
 * DocsPage.astro), and the sticky offset keeps it there while the page scrolls
 * under the pinned header.
 */
import type { PageSection } from '../../lib/sections'

interface Props {
  sections: PageSection[]
}

const { sections } = Astro.props
const links = [{ id: 'top', title: 'Top' }, ...sections]
---

<nav
  aria-label="On this page"
  data-docs-toc
  class="sticky top-[calc(var(--docs-header-height)+3.5rem-2px)] flex flex-col"
>
  <p class="mb-2 border-t-2 border-b border-t-foreground border-b-muted-foreground py-[10px] font-mono text-[11px] leading-[19px] font-medium tracking-[0.06em] uppercase [border-bottom-style:dashed]">
    On this page
  </p>
  <ul class="flex flex-col">
    {links.map((link) => (
      <li class="flex">
        <a
          href={`#${link.id}`}
          class:list={[
            'relative flex-1 border-s border-foreground py-[7px] ps-3 text-[13px] leading-5 [overflow-wrap:anywhere] text-muted-foreground hover:underline hover:underline-offset-4',
            // The bar sits over the 1px rule and grows 2px into the padding, so the text never moves.
            'before:absolute before:inset-y-0 before:-start-px before:w-[3px] before:bg-sidebar-primary before:opacity-0 before:transition-opacity before:duration-150 motion-reduce:before:transition-none data-in-view:before:opacity-100',
            'focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring',
          ]}
        >
          {link.title}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // A row is in view while its heading is on screen: the section title, the
  // Props group title or the prop name, and the page H1 for Top. A heading
  // under the pinned bar (the context bar below lg, the header from lg up)
  // doesn't count. Deep inside a long section no heading shows, so the row
  // whose heading was last scrolled past is marked instead and the rail is
  // never empty.
  const toc = document.querySelector<HTMLElement>('[data-docs-toc]')
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
    const headings = links.map((link, index) =>
      index === 0
        ? document.querySelector('h1')
        : document.getElementById(decodeURIComponent(link.hash.slice(1)))
    )
    const bars = [...document.querySelectorAll('[data-docs-context-bar], [data-docs-header]')]
    let frame = 0

    const update = () => {
      frame = 0
      // The context bar is display: none from lg up, which gives it a zero rect.
      const line = Math.max(0, ...bars.map((bar) => bar.getBoundingClientRect().bottom))
      const boxes = headings.map((heading) => heading?.getBoundingClientRect())
      const shown = boxes.map((box) => !!box && box.bottom > line && box.top < innerHeight)
      if (!shown.includes(true)) {
        const above = boxes.findLastIndex((box) => !!box && box.top < line)
        shown[Math.max(0, above)] = true
      }
      links.forEach((link, index) => link.toggleAttribute('data-in-view', shown[index]))
    }
    const schedule = () => {
      frame ||= requestAnimationFrame(update)
    }

    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', schedule)
    // Opening a code panel or switching example styles moves everything below it.
    new ResizeObserver(schedule).observe(document.body)
    update()
  }
</script>
