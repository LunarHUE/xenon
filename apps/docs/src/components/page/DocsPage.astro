---
/**
 * The frame around every docs page: breadcrumb, eyebrow, title and description,
 * the component tab strip, the article, and prev/next cards. The document
 * column grows with the window up to 90rem, and anything passed in the `toc`
 * slot docks 40px after it on wide screens rather than at the window edge.
 * Prose keeps its own measure inside the column (see .mdx in global.css).
 */
import Layout from '../../layouts/Layout.astro'
import type { PageLink } from '../../lib/content'
import { DocsBreadcrumb, type Crumb } from './docs-breadcrumb'
import type { SwitcherLink } from '../shell/context-crumbs'
import PageTabs from './PageTabs.astro'
import Pagination from './Pagination.astro'

interface Props {
  /** The H1. */
  title: string
  /** Document title, when it differs from the H1. */
  pageTitle?: string
  description: string
  /** Mono line above the H1, usually the import path. */
  eyebrow: string
  /** Trail above the header. The last crumb is this page. */
  breadcrumb: Crumb[]
  /** Components listed by the narrow bar's last crumb. */
  switcher?: SwitcherLink[]
  /** Component tabs, with the href of the current one. */
  tabs?: { label: string; links: PageLink[]; current: string }
  previous?: PageLink
  next?: PageLink
}

const { title, pageTitle, description, eyebrow, breadcrumb, switcher, tabs, previous, next } =
  Astro.props
const tab = tabs?.links.find((link) => link.href === tabs.current)?.label
// A slot filled by a false expression still counts for slots.has(), so check what it renders.
const toc = Astro.slots.has('toc') ? (await Astro.slots.render('toc')).trim() : ''
---

<Layout
  title={pageTitle ?? title}
  description={description}
  crumbs={breadcrumb}
  switcher={switcher}
>
  <div class="flex gap-10 px-6 md:px-8 xl:ps-10 xl:pe-6">
    <div class="min-w-0 flex-1 pb-10 xl:max-w-[90rem]">
      <div class="flex flex-col">
        {/*
          Below lg the trail moves into the bar under the header. From lg it
          pins under the header, and once the H1 has scrolled away it adds the
          current tab and the section in view (the script below). Both are
          aria-hidden: the H1, the tab strip and the TOC already say them.
        */}
        <div data-docs-trail class="docs-trail">
          <DocsBreadcrumb crumbs={breadcrumb} />
          {tab && (
            <span aria-hidden="true" class="docs-trail-late docs-trail-tab">
              {' / '}
              {tab}
            </span>
          )}
          <span aria-hidden="true" data-docs-readout class="docs-trail-late docs-trail-readout" />
        </div>
        <header class="flex flex-col gap-3 pt-8 pb-7">
          <p class="font-mono text-[13px] leading-[19px] text-muted-foreground">{eyebrow}</p>
          <h1 class="text-4xl leading-[44px] font-bold tracking-[-0.035em] sm:text-[44px] sm:leading-[52px]">
            {title}
          </h1>
          <p class="max-w-[42.5rem] text-lg leading-7">{description}</p>
        </header>
        {tabs && <PageTabs label={tabs.label} tabs={tabs.links} current={tabs.current} />}
        <article class="mdx">
          <slot />
        </article>
        <Pagination previous={previous} next={next} />
      </div>
    </div>
    {/*
      The breadcrumb row is 3.5rem with a rule at its foot; the TOC's 2px top
      rule ends on the same line, and Toc.astro sticks it there.
    */}
    {toc && (
      <aside class="hidden w-44 shrink-0 pt-[calc(3.5rem-2px)] pb-6 xl:block">
        <Fragment set:html={toc} />
      </aside>
    )}
  </div>
</Layout>

<script>
  import { pinnedLine } from '../../lib/pinned'

  // Sets html[data-title-gone] once the H1 is under the pinned chrome, and
  // writes the section in view into the trail: `02 / pending` for a numbered
  // section, the bare name for a Props group or a prop.
  const root = document.documentElement
  const title = document.querySelector('main h1')
  const readout = document.querySelector('[data-docs-readout]')
  const sections = [...document.querySelectorAll('.docs-section > h2')]
  const marks = [
    ...document.querySelectorAll<HTMLElement>(
      '.docs-section > h2, .docs-props h2, .docs-prop-name'
    ),
  ]
  const label = (mark: HTMLElement) => {
    const index = sections.indexOf(mark)
    const name = mark.textContent?.trim() ?? ''
    return index >= 0 ? `${String(index + 1).padStart(2, '0')} / ${name}` : name
  }

  let frame = 0
  const update = () => {
    frame = 0
    const line = pinnedLine()
    root.toggleAttribute('data-title-gone', !!title && title.getBoundingClientRect().bottom <= line)
    if (!readout) return
    // The section you're reading: the last heading in the top quarter of the
    // space under the chrome.
    const reading = line + (innerHeight - line) / 4
    const current = marks.findLast((mark) => mark.getBoundingClientRect().top <= reading)
    const text = current ? label(current) : ''
    if (readout.textContent !== text) readout.textContent = text
  }
  const schedule = () => {
    frame ||= requestAnimationFrame(update)
  }
  addEventListener('scroll', schedule, { passive: true })
  addEventListener('resize', schedule)
  new ResizeObserver(schedule).observe(document.body)
  update()
</script>
