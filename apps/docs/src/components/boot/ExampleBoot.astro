---
/**
 * Applies the stored Tailwind On/Off choice for examples before first paint, so
 * a reader who turned Tailwind off never sees the styled variant flash, and
 * again after a client-side navigation swap, which resets the <html> attributes.
 * Render in <head>. The key matches EXAMPLE_STYLE_KEY in lib/example-style.ts.
 */
---

<script is:inline>
  ;(() => {
    const apply = () => {
      try {
        if (localStorage.getItem('example-style') === 'unstyled') {
          document.documentElement.dataset.exampleStyle = 'unstyled'
        }
      } catch {}
    }
    apply()
    document.addEventListener('astro:after-swap', apply)
  })()
</script>
