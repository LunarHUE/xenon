---
/**
 * A live demo over its own source. Write `<Example name="button/pending" />` in
 * MDX; lib/example-demos.ts fills the slots with the hydrated demo from
 * src/examples/button/pending.tsx, and its `.unstyled.tsx` twin if there is one.
 *
 * The source comes from the same files through `?raw`, so the code shown is
 * always the code running. With a twin, the footer gets a Tailwind toggle. The
 * choice is page-wide and remembered (see ExampleBoot.astro), and CSS in
 * global.css shows one variant or the other from the attribute on <html>.
 *
 * Show code opens the source as its own panel after the frame and caption. In
 * a split Section the root drops out of the layout (display: contents), so the
 * frame takes the example column and the panel spans the whole row below.
 */
import { Code as CodeIcon } from 'lucide'
import Code from '../codeblock/Code.astro'
import { Icon } from '../ui/icon'
import { exampleId } from '../../lib/example-style'

interface Props {
  /** Demo path under src/examples, without `.tsx`. */
  name: string
  /** Short note under the frame. */
  caption?: string
}

const sources = import.meta.glob<string>('../../examples/**/*.tsx', {
  query: '?raw',
  import: 'default',
  eager: true,
})

const { name, caption } = Astro.props
const source = sources[`../../examples/${name}.tsx`]
if (source === undefined) throw new Error(`No example at src/examples/${name}.tsx`)
const unstyledSource = sources[`../../examples/${name}.unstyled.tsx`]
const hasUnstyled = unstyledSource !== undefined && Astro.slots.has('unstyled')
// Readers copy one component, so both variants show the same filename.
const filename = `${name.split('/').at(-1)}.tsx`
const codeId = exampleId(name)
const lines = (code: string) => code.replace(/\n$/, '').split('\n').length
const meta = (code: string, variant?: string) =>
  [`${lines(code)} lines`, variant].filter(Boolean).join(' · ')

// Both footer controls are toggles: raised on a hard shadow while on, flat while off.
const control = [
  'group inline-flex items-center gap-1.5 border border-foreground bg-background px-2 py-1 cursor-pointer',
  'motion-safe:transition-[translate,box-shadow] motion-safe:duration-[120ms]',
  'aria-expanded:shadow-[3px_3px_0_var(--color-foreground)] motion-safe:aria-expanded:-translate-0.5',
  'aria-pressed:shadow-[3px_3px_0_var(--color-foreground)] motion-safe:aria-pressed:-translate-0.5',
  'hover:bg-muted active:translate-0 active:shadow-none',
  'outline-offset-[3px] focus-visible:outline-2 focus-visible:outline-sidebar-primary',
]
---

<div data-slot="example" data-example class="flex min-w-0 flex-col gap-4">
  <div data-example-figure class="flex min-w-0 flex-col gap-4">
    <div class="flex min-w-0 flex-col border border-foreground shadow-[3px_3px_0_var(--color-border)]">
      <div
        data-example-stage
        data-example-variant={hasUnstyled ? 'tailwind' : undefined}
        class="flex min-h-39 flex-wrap items-center justify-center gap-4 bg-muted p-6 text-foreground"
      >
        <slot />
      </div>
      {hasUnstyled && (
        <div
          data-example-stage
          data-example-variant="unstyled"
          class="flex min-h-39 flex-wrap items-center justify-center gap-4 bg-muted p-6 text-foreground"
        >
          <slot name="unstyled" />
        </div>
      )}
      <div class="flex min-h-12 items-center justify-between gap-4 border-t border-foreground bg-background px-4 font-mono text-xs leading-5">
        <button
          type="button"
          data-example-disclosure
          aria-expanded="false"
          aria-controls={codeId}
          class:list={control}
        >
          <span class="group-aria-expanded:hidden">Show code</span>
          <span class="not-group-aria-expanded:hidden">Hide code</span>
          <Icon icon={CodeIcon} class="size-3.5" />
        </button>
        {hasUnstyled && (
          <button
            type="button"
            data-example-toggle
            aria-pressed="true"
            aria-label="Tailwind styles"
            class:list={control}
          >
            Tailwind
          </button>
        )}
      </div>
    </div>
    {caption && <p class="font-mono text-[13px] leading-[19px] text-muted-foreground">{caption}</p>}
  </div>
  <div
    id={codeId}
    hidden
    data-example-code
    class="min-w-0 [&_[data-slot=code-block]]:shadow-[3px_3px_0_var(--color-border)]"
  >
    <div data-example-variant={hasUnstyled ? 'tailwind' : undefined}>
      <Code
        code={source}
        lang="tsx"
        title={filename}
        meta={meta(source, hasUnstyled ? 'Tailwind' : undefined)}
        closes={codeId}
      />
    </div>
    {hasUnstyled && (
      <div data-example-variant="unstyled">
        <Code
          code={unstyledSource}
          lang="tsx"
          title={filename}
          meta={meta(unstyledSource, 'Unstyled')}
          closes={codeId}
        />
      </div>
    )}
  </div>
</div>

<script>
  import { EXAMPLE_STYLE_KEY } from '../../lib/example-style'

  const root = document.documentElement

  const setOpen = (disclosure: HTMLButtonElement, open: boolean) => {
    disclosure.setAttribute('aria-expanded', String(open))
    const region = document.getElementById(disclosure.getAttribute('aria-controls')!)
    if (region) region.hidden = !open
  }

  const syncToggles = () => {
    const pressed = String(root.dataset.exampleStyle !== 'unstyled')
    for (const toggle of document.querySelectorAll('[data-example-toggle]')) {
      toggle.setAttribute('aria-pressed', pressed)
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element
    const disclosure = target.closest<HTMLButtonElement>('[data-example-disclosure]')
    if (disclosure) {
      setOpen(disclosure, disclosure.getAttribute('aria-expanded') !== 'true')
      return
    }
    // The panel sits outside the frame, so closing it hands focus back to Show code.
    const close = target.closest('[data-example-close]')
    if (close) {
      const id = close.getAttribute('aria-controls')
      const owner = document.querySelector<HTMLButtonElement>(
        `[data-example-disclosure][aria-controls="${id}"]`
      )
      if (owner) {
        setOpen(owner, false)
        owner.focus()
      }
      return
    }
    const toggle = target.closest('[data-example-toggle]')
    if (toggle) {
      const style = toggle.getAttribute('aria-pressed') === 'true' ? 'unstyled' : 'tailwind'
      if (style === 'unstyled') root.dataset.exampleStyle = style
      else delete root.dataset.exampleStyle
      try {
        localStorage.setItem(EXAMPLE_STYLE_KEY, style)
      } catch {
        // Storage can be off; the choice still holds for this page.
      }
      syncToggles()
    }
  })
  syncToggles()
</script>
