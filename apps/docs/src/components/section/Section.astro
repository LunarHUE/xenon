---
/**
 * One numbered row of a docs page. The title sits in a mono gutter and the
 * content fills the rest. The number comes from a CSS counter on `.mdx`, so
 * reordering sections never means renumbering them. Rows stack when the article
 * is narrower than 48rem.
 *
 * Put an Example in the `example` slot to set it beside the text:
 *
 *     <Section title="pending">
 *     Use `pending` while an action is in progress.
 *
 *     Provide a visible progress label.
 *
 *     <Example slot="example" name="button/pending" />
 *     </Section>
 *
 * The columns share the row 364:436 until the text column reaches 364px, which
 * it then keeps; the example column takes the rest. An opened code panel spans
 * both columns under the row (see Example.astro).
 *
 * The first paragraph is the lead. Later paragraphs in the text column are
 * notes and render smaller and muted.
 */
import { sectionId } from '../../lib/sections'

interface Props {
  title: string
  /** Anchor for the heading. Defaults to the title in kebab case. */
  id?: string
}

const { title } = Astro.props
const id = Astro.props.id ?? sectionId(title)
const split = Astro.slots.has('example')
---

<section
  aria-labelledby={id}
  class="docs-section flex flex-col gap-4 border-t border-muted-foreground py-6 @3xl:flex-row @3xl:gap-6"
>
  <h2 id={id} class="shrink-0 @3xl:w-28 font-mono text-xs leading-5 font-medium">
    {title}
  </h2>
  <div class="docs-section-body flex min-w-0 flex-1 flex-col gap-4">
    {split ? (
      <div
        class:list={[
          'flex flex-col gap-4 [&>[data-slot=example]]:contents',
          '@3xl:grid @3xl:grid-cols-[minmax(0,364fr)_minmax(0,436fr)] @3xl:items-start @3xl:gap-6 @3xl:[&_[data-example-code]]:col-span-full',
          '@min-[60rem]:grid-cols-[22.75rem_minmax(0,1fr)]',
        ]}
      >
        <div class="flex min-w-0 flex-col gap-4 [&>p+p]:text-sm [&>p+p]:leading-5 [&>p+p]:text-muted-foreground">
          <slot />
        </div>
        <slot name="example" />
      </div>
    ) : (
      <slot />
    )}
  </div>
</section>
