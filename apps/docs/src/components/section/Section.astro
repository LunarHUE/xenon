---
/**
 * One numbered row of a docs page. The title sits in a mono gutter and the
 * content fills the rest. The number comes from a CSS counter on `.mdx`, so
 * reordering sections never means renumbering them. Rows stack when the article
 * is narrower than 48rem.
 */
import { sectionId } from '../../lib/sections'

interface Props {
  title: string
  /** Anchor for the heading. Defaults to the title in kebab case. */
  id?: string
}

const { title } = Astro.props
const id = Astro.props.id ?? sectionId(title)
---

<section
  aria-labelledby={id}
  class="docs-section flex flex-col gap-4 border-t border-muted-foreground py-6 @3xl:flex-row @3xl:gap-6"
>
  <h2 id={id} class="shrink-0 @3xl:w-28 scroll-mt-20 font-mono text-xs leading-5 font-medium">
    {title}
  </h2>
  <div class="docs-section-body flex min-w-0 flex-1 flex-col gap-4">
    <slot />
  </div>
</section>
