---
/**
 * One key cap. Write combinations as separate caps, so screen readers and the
 * eye both get the pieces: `<Kbd>Shift</Kbd> + <Kbd>Tab</Kbd>`.
 */
---

<kbd class="inline-block min-w-6 border border-b-2 border-muted-foreground bg-background px-1.5 text-center align-[1px] font-mono text-xs leading-4 font-normal whitespace-nowrap text-foreground">
  <slot />
</kbd>
