---
/**
 * The repository link. Wide screens get the word and an arrow; the narrow header
 * has room for an icon button only. It opens in the same tab like any link.
 */
import { buttonVariants } from '../ui/button'
import { cn } from '../../lib/utils'

const href = 'https://github.com/LunarHUE/xenon'
---

<a
  href={href}
  class={cn(
    'hidden h-8 items-center gap-1 text-sm leading-5 whitespace-nowrap text-foreground hover:text-sidebar-primary lg:inline-flex',
    'outline-offset-4 focus-visible:outline-2 focus-visible:outline-sidebar-primary'
  )}
>
  GitHub<span aria-hidden="true">↗</span>
</a>
<a
  href={href}
  aria-label="GitHub"
  class={cn(buttonVariants({ variant: 'outline', size: 'icon-sm' }), 'lg:hidden')}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="size-5"
  >
    <path
      d="M9 19c-4.3 1.3-4.3-2-6-2m12 5v-3.5c0-1 .1-1.4-.5-2 3.3-.4 6.5-1.6 6.5-7A5.5 5.5 0 0 0 19.5 6c.1-.4.7-2-.2-4 0 0-1.3-.4-4.3 1.5a15 15 0 0 0-8 0C4 1.6 2.7 2 2.7 2c-.9 2-.3 3.6-.2 4A5.5 5.5 0 0 0 1 9.5c0 5.4 3.2 6.6 6.5 7-.6.6-.6 1.2-.5 2V22"
      transform="translate(1 0) scale(.95 1)"
    ></path>
  </svg>
</a>
