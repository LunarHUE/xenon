---
/**
 * Opens the search palette. SearchBoot.astro listens for clicks on every
 * `[data-docs-search]` button and for the shortcuts, so this stays plain markup.
 * The shortcut hint shows ⌘K on Apple platforms and Ctrl K elsewhere;
 * PlatformBoot picks before first paint.
 */
import { cn } from '../../lib/utils'

interface Props {
  /** The narrow bar sets the hint apart, smaller and muted. */
  compact?: boolean
  class?: string
}

const { compact = false, class: className } = Astro.props
---

<button
  type="button"
  data-docs-search
  aria-keyshortcuts="Control+K Meta+K /"
  class={cn(
    'inline-flex h-8 cursor-pointer items-center text-sm leading-5 whitespace-nowrap text-foreground hover:text-sidebar-primary',
    'outline-offset-4 focus-visible:outline-2 focus-visible:outline-sidebar-primary',
    compact ? 'gap-6' : 'gap-[0.3em]',
    className
  )}
>
  <span>Search</span>
  <kbd class={cn('font-sans', compact && 'hidden text-[13px] text-muted-foreground sm:inline')}>
    <span class="mac:hidden">Ctrl K</span>
    <span class="hidden mac:inline">⌘K</span>
  </kbd>
</button>
