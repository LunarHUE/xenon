---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import ThemeBoot from '../components/boot/ThemeBoot.astro'
import ExampleBoot from '../components/boot/ExampleBoot.astro'
import SidebarShellBoot from '../components/boot/SidebarShellBoot.astro'
import SidebarPanelBoot from '../components/boot/SidebarPanelBoot.astro'
import PlatformBoot from '../components/boot/PlatformBoot.astro'
import SearchBoot from '../components/boot/SearchBoot.astro'
import SearchButton from '../components/shell/SearchButton.astro'
import GitHubLink from '../components/shell/GitHubLink.astro'
import { SearchPalette } from '../components/shell/search-palette'
import { ContextCrumbs, type SwitcherLink } from '../components/shell/context-crumbs'
import type { Crumb } from '../components/page/docs-breadcrumb'
import { ThemeToggle } from '../components/ui/theme-toggle'
import { Toaster } from '../components/ui/toast'
import { DocsSidebar } from '../components/docs-sidebar'
import { DocsMenuButton, DocsSidebarTrigger } from '../components/ui/sidebar-trigger-island'
import { currentHref, getNavigation } from '../lib/nav'
import { DOCS_VERSION } from '../lib/search'
import { sidebar } from '../lib/sidebar'

interface Props {
  title: string
  description: string
  /** Trail for the narrow bar. Docs pages pass their breadcrumb; wide screens show it in the page. */
  crumbs?: Crumb[]
  /** Components for the switcher in the last crumb, on component pages. */
  switcher?: SwitcherLink[]
}

const { title, description, crumbs, switcher } = Astro.props
const navigation = await getNavigation()

// On-demand rendering emits stored preferences so first paint needs no script.
// Prerendered pages have no request cookies and leave it to the boot components.
const cookie = (name: string) => (Astro.isPrerendered ? undefined : Astro.cookies.get(name)?.value)
const storedTheme = cookie('theme')
const initialTheme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : undefined
const storedSidebar = cookie('sidebar')
const initialSidebar =
  storedSidebar === 'compact' || storedSidebar === 'hidden' ? storedSidebar : 'expanded'
---

<!doctype html>
<html lang="en" data-theme={initialTheme} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Xenon docs</title>
    <ThemeBoot />
    <ExampleBoot />
    <PlatformBoot />
    <SearchBoot />
    {/*
     * Links swap the page in place (see lib/shell-swap.ts). The shell parts marked
     * transition:persist stay mounted with their state, and only <main> fades over.
     */}
    <ClientRouter />
  </head>
  <body>
    {/*
     * At lg the shell is a two-column grid: the docked sidebar runs the full height
     * in the first column and carries the wordmark and dock button in its top row;
     * the header and page share the second. The header shows its own wordmark while
     * the sidebar is compact or hidden, and its own button while it is hidden. Both
     * columns stay pinned while the document scrolls; --docs-header-height in
     * global.css tracks whichever bar is pinned at the top.
     */}
    <div data-docs-shell data-sidebar={initialSidebar} class="docs-shell">
      <SidebarShellBoot />
      {/* First in source so the wordmark and dock button lead the tab order at lg. */}
      <DocsSidebar
        sections={navigation}
        current={currentHref(navigation, Astro.url.pathname)}
        client:load
        transition:persist="docs-sidebar"
        transition:persist-props
      />
      <SidebarPanelBoot id={sidebar.id} />
      <header
        data-docs-header
        transition:persist="docs-header"
        class="flex h-14 items-center gap-3 border-b-2 border-foreground bg-background px-6 lg:sticky lg:top-0 lg:z-30 lg:gap-6"
      >
        <div
          data-docs-header-brand
          class="flex shrink-0 items-center justify-between gap-3 lg:w-44 lg:in-data-[sidebar=expanded]:hidden"
        >
          <a
            href="/docs/overview/"
            class="text-[28px] leading-[34px] font-bold tracking-[-0.04em] outline-offset-4 focus-visible:outline-2 focus-visible:outline-sidebar-primary"
          >
            xenon
          </a>
          {/* Docks the sidebar back while it is hidden. Below lg the menu button in the bar takes over. */}
          <div class="hidden lg:in-data-[sidebar=hidden]:flex">
            <DocsSidebarTrigger mobileQuery="not all" client:load />
          </div>
        </div>
        <div class="ms-auto flex items-center gap-3 lg:gap-6">
          <SearchButton class="hidden lg:inline-flex" />
          <GitHubLink />
          <ThemeToggle client:load />
        </div>
      </header>
      <div
        data-docs-context-bar
        class="sticky top-0 z-30 flex h-12 items-center gap-3 border-b border-foreground bg-background px-6 sm:gap-4 lg:hidden"
      >
        <DocsMenuButton client:load />
        {crumbs &&
          (switcher ? (
            <ContextCrumbs crumbs={crumbs} switcher={switcher} client:load />
          ) : (
            <ContextCrumbs crumbs={crumbs} />
          ))}
        <SearchButton compact class="ms-auto" />
      </div>
      <main data-docs-main class="min-w-0" transition:animate="fade">
        <slot />
      </main>
    </div>
    <Toaster client:load />
    <SearchPalette indexUrl="/search-index.json" version={DOCS_VERSION} client:idle />
  </body>
</html>

<script>
  import { swapShell } from '../lib/shell-swap'

  document.addEventListener('astro:before-swap', swapShell)
</script>
