---
import '../styles/global.css'
import { ThemeToggle } from '../components/ui/theme-toggle'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

// On-demand rendering emits the stored theme so first paint needs no script.
// Prerendered pages have no request cookie and leave it to the inline script.
const stored = Astro.isPrerendered ? undefined : Astro.cookies.get('theme')?.value
const initialTheme = stored === 'light' || stored === 'dark' ? stored : undefined
---

<!doctype html>
<html lang="en" data-theme={initialTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Xenon docs</title>
    <script is:inline>
      // Resolve the theme cookie before first paint. Runs again after a
      // client-side navigation swap, where the new document skips inline scripts.
      ;(() => {
        const apply = () => {
          const match = document.cookie.match(/(?:^|; )theme=(light|dark|system)(?:;|$)/)
          const preference = match ? match[1] : 'system'
          const resolved =
            preference === 'system'
              ? matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : preference
          document.documentElement.dataset.theme = resolved
        }
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>
  </head>
  <body>
    <main class="mx-auto max-w-5xl px-6 py-12">
      <header class="mb-8 flex justify-end">
        <ThemeToggle client:load />
      </header>
      <slot />
    </main>
  </body>
</html>
