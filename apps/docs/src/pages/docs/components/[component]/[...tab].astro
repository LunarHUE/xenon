---
import { render } from 'astro:content'
import DocsPage from '../../../../components/page/DocsPage.astro'
import Toc from '../../../../components/page/Toc.astro'
import { mdxComponents } from '../../../../components/mdx'
import { pageSections } from '../../../../lib/sections'
import {
  componentHref,
  getComponents,
  getDocs,
  pagination,
  type ComponentDoc,
  type ComponentTab,
} from '../../../../lib/content'

export async function getStaticPaths() {
  const components = await getComponents()
  return components.flatMap((component) =>
    component.tabs.map((tab) => ({
      // Overview is the component's own URL; the other tabs sit under it.
      params: { component: component.slug, tab: tab.tab === 'overview' ? undefined : tab.tab },
      props: { component, tab },
    }))
  )
}

interface Props {
  component: ComponentDoc
  tab: ComponentTab
}

const { component, tab } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(tab.entry)
const sections = pageSections(remarkPluginFrontmatter)
// Top plus one section is not worth a table of contents.
const toc = sections.length >= 2
const { previous, next } = pagination(component.tabs, component.tabs.indexOf(tab))
// The Components crumb links to the directory once that page exists.
const directory = (await getDocs()).some((entry) => entry.id === 'components')
// The switcher keeps you on the same tab where the other component has one.
const switcher = (await getComponents()).map((other) => ({
  label: other.title,
  href:
    other.tabs.find((candidate) => candidate.tab === tab.tab)?.href ?? componentHref(other.slug),
  current: other.slug === component.slug,
}))
---

<DocsPage
  title={component.title}
  pageTitle={tab.tab === 'overview' ? component.title : `${component.title} ${tab.label}`}
  description={component.description}
  eyebrow={component.status === 'draft' ? `${component.package} · Draft API` : component.package}
  breadcrumb={[
    { label: 'Components', href: directory ? '/docs/components/' : undefined },
    { label: component.title },
  ]}
  switcher={switcher}
  tabs={{ label: `${component.title} pages`, links: component.tabs, current: tab.href }}
  previous={previous}
  next={next}
>
  <Content components={mdxComponents} />
  {toc && <Toc slot="toc" sections={sections} />}
</DocsPage>
