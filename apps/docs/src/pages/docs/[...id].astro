---
import { render } from 'astro:content'
import DocsPage from '../../components/page/DocsPage.astro'
import Toc from '../../components/page/Toc.astro'
import { mdxComponents } from '../../components/mdx'
import { pageSections, sectionId } from '../../lib/sections'
import { docHref, getDirectory, getDocs, pagination, type DocEntry } from '../../lib/content'

export async function getStaticPaths() {
  const entries = await getDocs()
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

interface Props {
  entry: DocEntry
}

const { entry } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(entry)
// The directory's groups are built from the components collection, not written
// as Sections, so the plugin can't see them.
const groups =
  entry.id === 'components'
    ? (await getDirectory()).map(({ label }) => ({ id: sectionId(label), title: label }))
    : []
const sections = [...pageSections(remarkPluginFrontmatter), ...groups]
// Top plus one section is not worth a table of contents.
const toc = sections.length >= 2
// Start-here pages and guides read as one sequence, in sidebar order.
const pages = (await getDocs()).map((page) => ({ label: page.data.title, href: docHref(page) }))
const { previous, next } = pagination(
  pages,
  pages.findIndex((page) => page.href === docHref(entry))
)
const guide = entry.data.section === 'guides'
---

<DocsPage
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={guide ? 'Guides / Solid' : '@xenon-ui/solid'}
  breadcrumb={[{ label: guide ? 'Guides' : 'Start here' }, { label: entry.data.title }]}
  previous={previous}
  next={next}
>
  <Content components={mdxComponents} />
  {toc && <Toc slot="toc" sections={sections} />}
</DocsPage>
