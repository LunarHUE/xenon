---
import { render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Code from '../../components/codeblock/Code.astro'
import Section from '../../components/section/Section.astro'
import { docHref, getDocs, pagination, type DocEntry } from '../../lib/content'

export async function getStaticPaths() {
  const entries = await getDocs()
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

interface Props {
  entry: DocEntry
}

const { entry } = Astro.props
const { Content } = await render(entry)
// Start-here pages and guides read as one sequence, in sidebar order.
const pages = (await getDocs()).map((page) => ({ label: page.data.title, href: docHref(page) }))
const { previous, next } = pagination(
  pages,
  pages.findIndex((page) => page.href === docHref(entry))
)
---

<Layout title={entry.data.title} description={entry.data.description}>
  <h1 class="text-3xl font-medium">{entry.data.title}</h1>
  <p class="mt-4 text-muted-foreground">{entry.data.description}</p>
  <article class="mdx mt-10">
    <Content components={{ Code, Section }} />
  </article>
  <nav aria-label="Pagination" class="mt-10 flex justify-between text-sm">
    {previous ? <a href={previous.href}>Previous: {previous.label}</a> : <span />}
    {next && <a href={next.href}>Next: {next.label}</a>}
  </nav>
</Layout>
