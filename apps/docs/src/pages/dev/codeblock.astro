---
import CodeBlockPreview, {
  type CodeBlockSnippets,
  type Snippet,
} from '../../components/previews/codeblock-preview'
import { highlight } from '../../components/codeblock/highlight'
import Layout from '../../layouts/Layout.astro'

interface Source {
  filename: string
  lang: 'tsx'
  code: string
}

const short: Source = {
  filename: 'button.tsx',
  lang: 'tsx',
  code: `<Button disabled>\n  Save changes\n</Button>`,
}

const medium: Source = {
  filename: 'save-button.tsx',
  lang: 'tsx',
  code: `import { Button } from '@xenon/solid/button'\n\nexport function SaveButton(props: { pending: boolean }) {\n  return (\n    <div class="flex gap-4">\n      <Button focusableWhenDisabled disabled={props.pending} onClick={() => save()}>\n        Save changes\n      </Button>\n      <Button variant="outline" onClick={() => reset()}>\n        Cancel\n      </Button>\n    </div>\n  )\n}`,
}

const long: Source = {
  filename: 'autocomplete.tsx',
  lang: 'tsx',
  code: [
    `import { createSignal, For } from 'solid-js'`,
    `import { Combobox } from '@xenon/solid/combobox'`,
    ``,
    `const fruits = ['Apple', 'Banana', 'Cherry', 'Date', 'Elderberry', 'Fig', 'Grape']`,
    ``,
    `export function Search() {`,
    `  const [query, setQuery] = createSignal('')`,
    `  const matches = () => fruits.filter((fruit) => fruit.toLowerCase().includes(query().toLowerCase()))`,
    `  return (`,
    `    <Combobox>`,
    `      <Combobox.Input placeholder="Search" onInput={(event) => setQuery(event.currentTarget.value)} />`,
    `      <Combobox.Positioner>`,
    `        <Combobox.Content>`,
    `          <Combobox.Viewport>`,
    `            <For each={matches()}>{(fruit) => <Combobox.Item value={fruit}>{fruit}</Combobox.Item>}</For>`,
    `          </Combobox.Viewport>`,
    `          <Combobox.Empty>No results</Combobox.Empty>`,
    `        </Combobox.Content>`,
    `      </Combobox.Positioner>`,
    `    </Combobox>`,
    `  )`,
    `}`,
    ``,
    ...Array.from({ length: 6 }, (_, group) => [
      `export function Group${group + 1}() {`,
      `  return (`,
      `    <Combobox.Group label="Group ${group + 1}">`,
      `      <Combobox.Item value="${group + 1}-a">Item A</Combobox.Item>`,
      `      <Combobox.Item value="${group + 1}-b">Item B</Combobox.Item>`,
      `      <Combobox.Item value="${group + 1}-c">Item C</Combobox.Item>`,
      `    </Combobox.Group>`,
      `  )`,
      `}`,
      ``,
    ]).flat(),
  ].join('\n'),
}

async function toSnippet(source: Source): Promise<Snippet> {
  return { ...source, html: await highlight(source.code, source.lang) }
}

const snippets: CodeBlockSnippets = {
  short: await toSnippet(short),
  medium: await toSnippet(medium),
  long: await toSnippet(long),
}
---

<Layout
  title="Code block playground"
  description="Highlighted source with copy actions and a collapsible trigger bar."
>
  <a href="/" class="text-sm text-muted-foreground underline underline-offset-4">
    Xenon docs
  </a>
  <h1 class="mt-6 mb-10 text-3xl font-medium">Code block</h1>
  <CodeBlockPreview snippets={snippets} client:load />
</Layout>
