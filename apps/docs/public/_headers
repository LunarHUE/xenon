# Cloudflare static asset headers. Served as-is by Workers Static Assets and the
# Astro Cloudflare adapter; a Worker serving the build from R2 has to send the same.

# Pages stay fresh for a minute, so a page prefetched on hover is still in the
# browser cache when the client router fetches it on click. After that the
# browser shows the cached copy and refreshes it in the background.
/docs/*
  Cache-Control: public, max-age=60, stale-while-revalidate=300

# Bundled assets have a content hash in their names and never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
