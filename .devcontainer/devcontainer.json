{
  "name": "${localWorkspaceFolderBasename} — Nix Dev Environment",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile",
    "args": {
      "PRETTY_HOSTNAME": "${localWorkspaceFolderBasename} Repo"
    }
  },

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "mounts": [
    "source=/mnt/user-home,target=/mnt/user-home,type=bind",
    "source=lunarhue-containers-nix-store,target=/nix,type=volume"
  ],
  "runArgs": [
    "--tmpfs",
    "/mnt/user-home/codex/tmp:rw,exec,nosuid,nodev,mode=0700,uid=1000,gid=1000,size=64m"
  ],

  "remoteEnv": {
    "NIX_CONFIG": "experimental-features = nix-command flakes\nbuild-users-group ="
  },
  "updateRemoteUserUID": false,

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000",
      "installZsh": false,
      "installOhMyZsh": false,
      "configureZshAsDefaultShell": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": "false"
    }
  },

  "containerEnv": {
    "CODEX_HOME": "/mnt/user-home/codex",
    "CLAUDE_CONFIG_DIR": "/mnt/user-home/claude",
    "BASH_ENV": "/home/vscode/.bashrc"
  },

  "postCreateCommand": "bash .devcontainer/create.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  "customizations": {
    "vscode": {
      "extensions": ["mkhl.direnv", "jnoortheen.nix-ide", "golang.go"],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.checkForUpdates": "off",
        "go.toolsManagement.autoUpdate": false
      }
    }
  },

  "remoteUser": "vscode"
}
