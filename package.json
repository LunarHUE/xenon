{
  "name": "xenon",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "npm:@typescript/typescript6@^6.0.2",
      "@typescript/native": "npm:typescript@^7.0.2",
      "eslint": "^10.10.0",
      "vitest": "^5.0.0",
      "solid-js": "2.0.0-rc.8",
      "@solidjs/web": "2.0.0-rc.8",
      "@types/bun": "^1.4.2"
    }
  },
  "overrides": {
    "@solidjs/signals": "2.0.0-rc.8"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  }
}
